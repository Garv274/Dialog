{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
 // Or "bundler" if using a modern React Native template
    "strict": true,        // Skips type checking of declaration files
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
